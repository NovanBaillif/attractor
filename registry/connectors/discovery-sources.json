      ],
      "endpoint": "https://hol.org/registry/api/v1/search",
      "parameters": {
        "q": "optional string",
        "page": "1-indexed integer, default 1",
        "limit": "integer 1..500, default 20",
        "registries": "optional comma-separated registry identifiers",
        "includeAggregations": "optional true/false string"
      },
      "pagination": "page/limit + total; preserve limited and totalBeforeFilters/totalAvailable where present. A limited result does not establish an exhaustive registry total. No cursor field observed.",
      "auth": "Keyword discovery documented as public and no credentials used in probes.",
      "rateLimit": "No rate headers in sampled keyword responses. Documentation describes vector-search rate limiting; no numeric keyword quota established.",
      "identity": "Use uaid as provider identifier. originalId can repeat between listings. Registry is declared origin, not a verified community membership.",
      "version": "profile.version is a profile format version, not necessarily the revision of an agent record. Use updatedAt/hash for observed content."
    },
    {
      "id": "nanda",
      "docs": [
        "https://github.com/projnanda/nanda-index-v2",
